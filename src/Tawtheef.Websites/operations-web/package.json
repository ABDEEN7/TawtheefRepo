{
  "name": "operations-web",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node scripts/generate-version.js",
    "build": "ng build",
    "build:dev": "node scripts/generate-version.js && ng build --configuration development",
    "build:pre-stage": "node scripts/generate-version.js && ng build --configuration pre-stage",
    "build:stage": "node scripts/generate-version.js && ng build --configuration stage",
    "build:prod": "node scripts/generate-version.js && ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "doc": "npx compodoc -p tsconfig.json"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.25",
    "@angular/common": "20.3.25",
    "@angular/compiler": "20.3.25",
    "@angular/core": "20.3.25",
    "@angular/forms": "20.3.25",
    "@angular/localize": "20.3.25",
    "@angular/platform-browser": "20.3.25",
    "@angular/router": "20.3.25",
    "@auth0/angular-jwt": "^5.2.0",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@ng-bootstrap/ng-bootstrap": "19.0.1",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@primeuix/themes": "^1.2.5",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "^1.13.1",
    "chart.js": "^4.4.9",
    "google-libphonenumber": "^3.2.43",
    "ngx-bootstrap": "^20.0.2",
    "ngx-intl-tel-input": "^17.0.0",
    "ngx-translate-multi-http-loader": "^20.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^20.4.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular/build": "20.3.25",
    "@angular/cli": "20.3.25",
    "@angular/compiler-cli": "20.3.25",
    "@compodoc/compodoc": "^1.1.32",
    "@types/google-libphonenumber": "^7.4.30",
    "@types/jasmine": "~5.1.0",
    "baseline-browser-mapping": "^2.9.17",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@angular/*": "^20.0.0"
  }
}
