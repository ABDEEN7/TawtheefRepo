<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <urlCompression doStaticCompression="true" />
    <httpCompression>
      <scheme name="gzip" dll="%Windir%\system32\inetsrv\gzip.dll" />
    </httpCompression>
    
    <!-- 1) Remove/Mitigate info disclosure headers -->
    <httpProtocol>
      <customHeaders>
        <!-- Remove common verbose headers -->
        <remove name="X-Powered-By" />
        <remove name="X-AspNet-Version" />
        <remove name="X-AspNetMvc-Version" />
      </customHeaders>
    </httpProtocol>

    <!-- IIS 10+ can remove the Server header (works only on supported builds) -->
    <security>
      <requestFiltering removeServerHeader="true" />
    </security>

    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".ttf" />
      <mimeMap fileExtension=".ttf" mimeType="font/ttf" />
      <remove fileExtension=".otf" />
      <mimeMap fileExtension=".otf" mimeType="font/otf" />
      <remove fileExtension=".eot" />
      <mimeMap fileExtension=".eot" mimeType="application/vnd.ms-fontobject" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
    </staticContent>

    <rewrite>
      <outboundRules>

        <!-- A) Never cache HTML -->
        <rule name="NoCache_HTML">
          <match serverVariable="RESPONSE_Cache-Control" pattern=".*" />
          <conditions>
            <add input="{RESPONSE_Content-Type}" pattern="^text/html" />
          </conditions>
          <action type="Rewrite" value="no-cache, no-store, must-revalidate" />
        </rule>

        <!-- B) No-cache for translations + version/config files -->
        <rule name="NoCache_Dynamic_Json">
          <match serverVariable="RESPONSE_Cache-Control" pattern=".*" />
          <conditions>
            <add input="{URL}" pattern="^/assets/i18n/.*\.json$|^/version\.json$|^/assets/version\.json$|^/assets/config/.*\.json$" />
          </conditions>
          <action type="Rewrite" value="no-cache, no-store, must-revalidate" />
        </rule>

        <!-- C) Long cache for hashed static assets -->
        <rule name="Cache_Static_Assets_1Year">
          <match serverVariable="RESPONSE_Cache-Control" pattern=".*" />
          <conditions>
            <add input="{URL}" pattern="\.(js|mjs|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|otf|eot|webmanifest)$" />
          </conditions>
          <action type="Rewrite" value="public, max-age=31536000, immutable" />
        </rule>

        <!-- 2) HSTS (only when HTTPS is ON) -->
        <rule name="Add_HSTS" stopProcessing="true">
          <match serverVariable="RESPONSE_Strict-Transport-Security" pattern=".*" />
          <conditions>
            <add input="{HTTPS}" pattern="on" />
          </conditions>
          <!-- includeSubDomains + preload are optional; keep/remove based on your readiness -->
          <action type="Rewrite" value="max-age=31536000; includeSubDomains" />
        </rule>

        <!-- 3) CSP for API responses (JSON): very strict -->
        <rule name="Add_CSP_For_API_JSON" stopProcessing="true">
          <match serverVariable="RESPONSE_Content-Security-Policy" pattern=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{URL}" pattern="^/api/" />
            <add input="{RESPONSE_Content-Type}" pattern="^application/json" />
          </conditions>
          <action type="Rewrite" value="default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" />
        </rule>

        <!-- 4) OPTIONAL: CSP for SPA HTML (adjust if you use CDNs, analytics, etc.) -->
        <rule name="Add_CSP_For_HTML" stopProcessing="true">
          <match serverVariable="RESPONSE_Content-Security-Policy" pattern=".*" />
          <conditions>
            <add input="{RESPONSE_Content-Type}" pattern="^text/html" />
          </conditions>
          <action type="Rewrite" value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'" />
        </rule>

      </outboundRules>

      <!-- SPA routing -->
      <rules>
        <rule name="Angular Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

  </system.webServer>
</configuration>
