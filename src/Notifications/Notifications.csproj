<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>Tawtheef.Notifications</AssemblyName>
        <RootNamespace>Tawtheef.Notifications</RootNamespace>
    </PropertyGroup>


    <ItemGroup>
      <ProjectReference Include="..\Domain\Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="RazorLight" />
      <PackageReference Include="System.Drawing.Common" />
      <PackageReference Include="System.Formats.Nrbf" />
    </ItemGroup>


  <ItemGroup>
    <None Remove="Templates\**\*.cshtml" />
    <EmbeddedResource Include="Templates\**\*.cshtml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>
</Project>