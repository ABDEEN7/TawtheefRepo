@model Tawtheef.Notifications.Context.TemplateContext<Tawtheef.Notifications.Templates.OfficeCreatedNotification.OfficeCreatedNotificationModel>

@{
    var b = Model.Branding;
    var m = Model.Model;

    var product = b.ProductName;
    var support = b.SupportEmail;
    var website = b.WebsiteUrl;

    var officeName = string.IsNullOrWhiteSpace(m.OfficeNameEn) ? "New Office" : m.OfficeNameEn;
    var officeCode = string.IsNullOrWhiteSpace(m.OfficeCode) ? "-" : m.OfficeCode;
    var adminEmail = string.IsNullOrWhiteSpace(m.AdminEmail) ? "your account" : m.AdminEmail;
}

Subject: @($"{product} - Recruitment Office Created")

Dear Administrator,

A new recruitment office has been successfully created in @product.

Office Details:
- Office Name: @officeName
- Office Code: @officeCode
- Administrator Email: @adminEmail

Access Instructions:
1) Ensure you are connected to the corporate VPN (if required)
2) Visit the platform: @website
3) Login using your assigned email: @adminEmail

Regards,
The @product Team