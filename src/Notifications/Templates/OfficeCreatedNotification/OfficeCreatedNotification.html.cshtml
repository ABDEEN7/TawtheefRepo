@model Tawtheef.Notifications.Context.TemplateContext<Tawtheef.Notifications.Templates.OfficeCreatedNotification.OfficeCreatedNotificationModel>

@{
    var b = Model.Branding;
    var m = Model.Model;

    var primary = b.PrimaryHex;
    var product = b.ProductName;
    var support = b.SupportEmail;
    var website = b.OperationsUrl;
    var logo = b.LogoUrl;

    var officeName = string.IsNullOrWhiteSpace(m.OfficeNameEn) ? "New Office" : m.OfficeNameEn;
}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@product - New Recruitment Office Created</title>
  <style>
    body { margin:0; padding:0; background:#f6f7fb; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color:#111827; }
    .container { max-width:600px; margin:24px auto; background:#ffffff; border:1px solid #e5e7eb; border-radius:14px; overflow:hidden; box-shadow:0 8px 20px rgba(0,0,0,0.06); }
    .brand-bar { height:8px; background:@primary; }
    .content { padding:28px; }
    .title { font-size:22px; font-weight:700; margin:0 0 12px; }
    .text { font-size:15px; line-height:22px; margin:0 0 16px; }
    .badge { display:inline-block; font-size:13px; font-weight:700; color:@primary; background:#f7f1f5; padding:6px 10px; border-radius:999px; }
    .cta { display:inline-block; padding:12px 18px; background:@primary; color:#ffffff; text-decoration:none; border-radius:8px; font-weight:700; font-size:14px; }
    .data-box { background:#f9fafb; border:1px solid #e5e7eb; padding:16px; border-radius:10px; margin-bottom:16px; }
    .data-item { font-size:14px; margin-bottom:6px; color:#374151; }
    .label { font-weight:700; color:#111827; margin-right: 8px; }
    .muted { font-size:12px; color:#6b7280; margin:0; }
    .footer { padding:0 28px 24px; }
    .logo { max-width:180px; max-height:60px; width:auto; height:auto; }
    .divider { height:1px; background:#e5e7eb; margin:20px 0; }
  </style>
</head>
<body>
  <div class="container">
    <div class="brand-bar"></div>
    <div class="content">
      @if (!string.IsNullOrWhiteSpace(logo))
      {
        <a href="@website" target="_blank">
          <img class="logo" src="@logo" alt="@product" style="display: block; margin: 0 auto 20px; max-height: 60px; width: auto;">
        </a>
      }
      <p class="badge">New Office</p>
      <h1 class="title">New Office Created</h1>
      <p class="text">Dear Officer,</p>
      <p class="text">
        A new office has been created in the Careers platform.
      </p>
      <div class="data-box">
        <div class="data-item"><span class="label">Office Name:</span> “@officeName”</div>
        <div class="data-item"><span class="label">Country:</span> “@m.CountryEn”</div>
        <div class="data-item"><span class="label">Manager Email:</span> “@m.AdminEmail”</div>
      </div>
      <p class="text">
        You have been granted access to manage candidate profiles and office members within your assigned country.
      </p>
      <a class="cta" style="color: white;" href="@website" target="_blank">Access Dashboard</a>
      <div class="divider"></div>
      <p class="muted">
        Portal Link: @website
      </p>
    </div>
    <div class="footer">
      <p class="muted">Regards,<br>@product Team</p>
      <p class="muted">© @(DateTime.UtcNow.Year) @product. All rights reserved.</p>
    </div>
  </div>
</body>
</html>
