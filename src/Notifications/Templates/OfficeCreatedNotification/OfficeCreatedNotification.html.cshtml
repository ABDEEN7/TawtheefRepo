@model Tawtheef.Notifications.Context.TemplateContext<Tawtheef.Notifications.Templates.OfficeCreatedNotification.OfficeCreatedNotificationModel>

@{
    var b = Model.Branding;
    var m = Model.Model;

    var primary = b.PrimaryHex;
    var product = b.ProductName;
    var support = b.SupportEmail;
    var website = b.WebsiteUrl;
    var logo = b.LogoUrl;

    // Model fields (adjust names to match your model)
    var officeName = string.IsNullOrWhiteSpace(m.OfficeName) ? "New Office" : m.OfficeName;
    var officeCode = string.IsNullOrWhiteSpace(m.OfficeCode) ? "-" : m.OfficeCode;
    var adminEmail = string.IsNullOrWhiteSpace(m.AdminEmail) ? "your Google account" : m.AdminEmail;
}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@product - Office Created</title>
  <style>
    body { margin:0; padding:0; background:#f6f7fb; font-family: Arial, sans-serif; color:#111827; }
    .container { max-width:600px; margin:24px auto; background:#ffffff; border:1px solid #e5e7eb; border-radius:14px; overflow:hidden; box-shadow:0 8px 20px rgba(0,0,0,0.06); }
    .brand-bar { height:8px; background:@primary; }
    .content { padding:28px; }
    .title { font-size:22px; font-weight:700; margin:0 0 12px; }
    .text { font-size:15px; line-height:22px; margin:0 0 16px; }
    .badge { display:inline-block; font-size:13px; font-weight:700; color:@primary; background:#f7f1f5; padding:6px 10px; border-radius:999px; }
    .cta { display:inline-block; padding:12px 18px; background:@primary; color:#ffffff !important; text-decoration:none; border-radius:8px; font-weight:700; font-size:14px; }
    .muted { font-size:12px; color:#6b7280; margin:0; }
    .footer { padding:0 28px 24px; }
    .logo { max-width:140px; height:auto; }
    .divider { height:1px; background:#e5e7eb; margin:20px 0; }
    .card { background:#f9fafb; border:1px solid #e5e7eb; border-radius:12px; padding:14px 16px; margin:0 0 16px; }
    .row { margin:0 0 8px; font-size:14px; }
    .label { color:#6b7280; }
    .value { font-weight:700; }
    code { font-family: Consolas, Monaco, monospace; font-size: 13px; }
  </style>
</head>

<body>
  <div class="container">
    <div class="brand-bar"></div>

    <div class="content">
      @if (!string.IsNullOrWhiteSpace(logo))
      {
        <a href="@website">
          <img class="logo" src="@logo" alt="@product">
        </a>
      }

      <p class="badge">Office Created</p>

      <h1 class="title">A new office has been created</h1>

      <p class="text">Dear Admin,</p>

      <p class="text">
        The office <strong>@officeName</strong> has been successfully created in <strong>@product</strong>.
      </p>

      <div class="card">
        <p class="row">
          <span class="label">Office Name:</span>
          <span class="value">@officeName</span>
        </p>
        <p class="row">
          <span class="label">Office Code:</span>
          <span class="value"><code>@officeCode</code></span>
        </p>
        <p class="row" style="margin:0;">
          <span class="label">Admin Login Email:</span>
          <span class="value">@adminEmail</span>
        </p>
      </div>

      <p class="text">
        To access the system, please connect using <strong>VPN in Qatar</strong>, then open the portal and sign in using your
        <strong>Google account</strong> with the email: <strong>@adminEmail</strong>.
      </p>

      <a class="cta" style="color: white;" href="@website">Open @product</a>

      <div class="divider"></div>

      <p class="muted">
        If the button does not work, copy and paste this link into your browser: @website
      </p>
      <p class="muted">
        Login method: Google Sign-In (@adminEmail)
      </p>
    </div>

    <div class="footer">
      <p class="muted">Regards,<br>@product Team</p>
      <p class="muted">
        Support: <a href="mailto:@support" style="color:@primary; text-decoration:none;">@support</a>
      </p>
      <p class="muted">© @(DateTime.UtcNow.Year) @product. All rights reserved.</p>
    </div>
  </div>
</body>
</html>
