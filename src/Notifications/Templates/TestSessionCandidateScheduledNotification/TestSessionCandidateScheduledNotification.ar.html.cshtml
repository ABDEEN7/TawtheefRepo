@model Tawtheef.Notifications.Context.TemplateContext<Tawtheef.Notifications.Templates.TestSessionCandidateScheduledNotification.TestSessionCandidateScheduledNotificationModel>
@{
    var b = Model.Branding;
    var m = Model.Model;
    var product = b.ProductNameAr;
    var website = b.RecruitmentUrl;
    var logo = b.LogoUrl;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@product - موعد الاختبار</title>
  <style>
    body { margin:0; padding:0; background:#f6f7fb; font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif; color:#111827; }
    .container { max-width:600px; margin:24px auto; background:#fff; border:1px solid #e5e7eb; border-radius:14px; overflow:hidden; box-shadow:0 8px 20px rgba(0,0,0,.06); }
    .brand-bar { height:8px; background:@b.PrimaryHex; }
    .content { padding:28px; text-align:right; }
    .title { font-size:22px; font-weight:700; margin:0 0 12px; }
    .text { font-size:15px; line-height:22px; margin:0 0 16px; }
    .badge { display:inline-block; font-size:13px; font-weight:700; color:@b.PrimaryHex; background:#f7f1f5; padding:6px 10px; border-radius:999px; }
    .cta { display:inline-block; padding:12px 18px; background:@b.PrimaryHex; color:#fff; text-decoration:none; border-radius:8px; font-weight:700; font-size:14px; }
    .muted { font-size:12px; color:#6b7280; margin:0; }
    .footer { padding:0 28px 24px; text-align:right; }
    .logo { max-width:140px; height:auto; }
    .divider { height:1px; background:#e5e7eb; margin:20px 0; }
  </style>
</head>
<body dir="rtl">
  <div class="container" style="direction:rtl">
    <div class="brand-bar"></div>
    <div class="content">
      @if (!string.IsNullOrWhiteSpace(logo))
      {
        <a href="@website" target="_blank"><img class="logo" src="@logo" alt="@product" style="display:block;margin:0 auto;"></a><br>
      }
      <p class="badge">تحديد موعد الاختبار</p>
      <h1 class="title">تم تحديد موعد اختبار لك</h1>
      <p class="text">مرشحنا العزيز،</p>
      <p class="text">تم تحديدك لاختبار لوظيفة <strong>@m.JobNameAr</strong> بتاريخ <strong>@m.TestDate.ToString("yyyy/MM/dd", System.Globalization.CultureInfo.InvariantCulture)</strong> من الساعة <strong>@m.StartTime.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture)</strong> إلى <strong>@m.EndTime.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture)</strong> في <strong>@m.LocationNameAr - @m.RoomNameAr</strong>.</p>
      <p class="text">رابط الموقع: <a href="@m.LocationUrl" target="_blank" rel="noopener noreferrer">@m.LocationUrl</a></p>
      <div class="divider"></div>
      <p class="muted">رابط النظام: @website</p>
    </div>
    <div class="footer"><p class="muted">مع أطيب التحيات،<br>فريق @product</p><p class="muted">© @(DateTime.UtcNow.Year) @product. جميع الحقوق محفوظة.</p></div>
  </div>
</body>
</html>
