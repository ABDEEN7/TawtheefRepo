@model Tawtheef.Notifications.Context.TemplateContext<Tawtheef.Notifications.Templates.ExamSubmittedForApprovalNotification.ExamSubmittedForApprovalNotificationModel>

@{
    var branding = Model.Branding;
    var exam = Model.Model;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head><meta charset="utf-8"><title>@branding.ProductNameAr - تم إرسال الاختبار للاعتماد</title></head>
<body dir="rtl">
  <p>تم إرسال اختبار لاعتمادكم.</p>
  <p><strong>الاختبار:</strong> @exam.ExamNumber — @exam.ExamTitleAr</p>
  <p><strong>الوظيفة:</strong> @exam.JobTitleAr</p>
</body>
</html>
