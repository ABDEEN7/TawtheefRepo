@model Tawtheef.Notifications.Context.TemplateContext<Tawtheef.Notifications.Templates.ExamSubmittedForApprovalNotification.ExamSubmittedForApprovalNotificationModel>
@{
    var branding = Model.Branding;
    var exam = Model.Model;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@branding.ProductNameAr - تم إرسال الاختبار للاعتماد</title>
    <style>body {
            margin: 0;
            padding: 0;
            background: #f6f7fb;
            color: #111827;
            font-family: 'Segoe UI', Tahoma, sans-serif
        }

        .container {
            max-width: 600px;
            margin: 24px auto;
            overflow: hidden;
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 14px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, .06)
        }

        .brand-bar {
            height: 8px;
            background:@branding.PrimaryHex
        }

        .content {
            padding: 28px;
            text-align: right
        }

        .title {
            margin: 0 0 12px;
            font-size: 22px
        }

        .text {
            margin: 0 0 16px;
            font-size: 15px;
            line-height: 22px
        }

        .footer {
            padding: 0 28px 24px;
            color: #6b7280;
            font-size: 12px;
            text-align: right
        }</style>
</head>
<body dir="rtl">
<div class="container">
    <div class="brand-bar"></div>
    <div class="content"><h1 class="title">تم إرسال الاختبار للاعتماد</h1>
        <p class="text">تحية طيبة،</p>
        <p class="text">تم إرسال الاختبار <strong>@exam.ExamNumber</strong> — @exam.ExamTitleAr للاعتماد.</p>
        <p class="text"><strong>الوظيفة:</strong><br>@exam.JobTitleAr</p></div>
    <div class="footer">مع التحيات،<br>فريق عمل @branding.ProductNameAr</div>
</div>
</body>
</html>