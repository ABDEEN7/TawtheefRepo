@model Tawtheef.Notifications.Context.TemplateContext<Tawtheef.Notifications.Templates.ContactVerificationSent.ContactVerificationSentModel>

@{
    var b = Model.Branding;
    var m = Model.Model;

    var primary = b.PrimaryHex;
    var product = b.ProductName;
    var support = b.SupportEmail;
    var website = b.WebsiteUrl;

    var verficationCode = m.Code;
    var logo = b.LogoUrl;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@product - رمز التحقق</title>
    <style>
        body { font-family: 'Arial', sans-serif; background-color: #f7f4f6; margin: 0; padding: 20px; direction: rtl; }
        .container { max-width: 600px; margin: 0 auto; background: #ffffff; border-radius: 14px; overflow: hidden; border: 1px solid #efe7eb; box-shadow: 0 6px 20px rgba(0,0,0,0.06); }
        .brand-bar { background: @primary; height: 8px; }
        .content { padding: 40px; text-align: center; }
        .h2 { font-size: 24px; color: #111827; margin-bottom: 20px; font-weight: 800; }
        .text { font-size: 16px; line-height: 24px; color: #374151; margin-bottom: 30px; }
        .code-box { font-size: 32px; letter-spacing: 8px; color: @primary; background: #fbf6f8; border: 2px solid #efe7eb; padding: 15px 25px; border-radius: 10px; display: inline-block; font-weight: 700; margin: 20px 0; }
        .footer { padding: 20px; background: #fafafa; border-top: 1px solid #efe7eb; color: #6b7280; font-size: 12px; }
    </style>
</head>
<body>
    <div class="container" style="direction: rtl;">
        <div class="brand-bar"></div>
        <div class="content">
            @if (!string.IsNullOrWhiteSpace(logo))
            {
                <img src="@logo" alt="@product" width="140" style="margin-bottom: 30px;">
            }
            <h2 class="h2">رمز التحقق من البريد الإلكتروني</h2>
            <p class="text">
                يرجى استخدام الرمز التالي لتأكيد عنوان بريدك الإلكتروني في منصة @product:
            </p>
            <div class="code-box">@verficationCode</div>
            <p class="text">
                إذا لم تطلب هذا الرمز، يرجى تجاهل هذه الرسالة.
            </p>
        </div>
        <div class="footer">
            <p>تم الإرسال بواسطة منصة @product</p>
            <p>© @(DateTime.UtcNow.Year) جميع الحقوق محفوظة.</p>
        </div>
    </div>
</body>
</html>
