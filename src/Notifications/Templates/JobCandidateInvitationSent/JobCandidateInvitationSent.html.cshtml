@model Tawtheef.Notifications.Context.TemplateContext<Tawtheef.Notifications.Templates.JobCandidateInvitationSent.JobCandidateInvitationSentModel>

@{
    var b = Model.Branding;
    var m = Model.Model;

    var primary = b.PrimaryHex;
    var product = b.ProductName;
    var support = b.SupportEmail;
    var website = b.WebsiteUrl;
    var logo = b.LogoUrl;

    var jobTitle = string.IsNullOrWhiteSpace(m.JobTitle) ? "a role on our platform" : m.JobTitle;
}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@product - Job Invitation</title>
  <style>
    body { margin:0; padding:0; background:#f6f7fb; font-family: Arial, sans-serif; color:#111827; }
    .container { max-width:600px; margin:24px auto; background:#ffffff; border:1px solid #e5e7eb; border-radius:14px; overflow:hidden; box-shadow:0 8px 20px rgba(0,0,0,0.06); }
    .brand-bar { height:8px; background:@primary; }
    .content { padding:28px; }
    .title { font-size:22px; font-weight:700; margin:0 0 12px; }
    .text { font-size:15px; line-height:22px; margin:0 0 16px; }
    .badge { display:inline-block; font-size:13px; font-weight:700; color:@primary; background:#f7f1f5; padding:6px 10px; border-radius:999px; }
    .cta { display:inline-block; padding:12px 18px; background:@primary; color:#ffffff; text-decoration:none; border-radius:8px; font-weight:700; font-size:14px; }
    .muted { font-size:12px; color:#6b7280; margin:0; }
    .footer { padding:0 28px 24px; }
    .logo { max-width:140px; height:auto; }
    .divider { height:1px; background:#e5e7eb; margin:20px 0; }
  </style>
</head>
<body>
  <div class="container">
    <div class="brand-bar"></div>
    <div class="content">
      @if (!string.IsNullOrWhiteSpace(logo))
      {
        <a href="@website">
          <img class="logo" src="@logo" alt="@product">
        </a>
      }
      <p class="badge">Invitation to apply</p>
      <h1 class="title">You are invited to apply</h1>
      <p class="text">Dear Candidate,</p>
      <p class="text">
        You have been invited to apply for <strong>@jobTitle</strong> on @product.
      </p>
      <p class="text">
        Please sign in to review the opportunity and submit your application.
      </p>
      <a class="cta" href="@website">View invitation</a>
      <div class="divider"></div>
      <p class="muted">
        If the button does not work, copy and paste this link into your browser: @website
      </p>
    </div>
    <div class="footer">
      <p class="muted">Best regards,<br>@product Team</p>
      <p class="muted">Support: <a href="mailto:@support" style="color:@primary; text-decoration:none;">@support</a></p>
      <p class="muted">© @(DateTime.UtcNow.Year) @product. All rights reserved.</p>
    </div>
  </div>
</body>
</html>
