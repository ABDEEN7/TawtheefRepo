@using Tawtheef.Notifications.Templates.InterviewShared
@model Tawtheef.Notifications.Context.TemplateContext<Tawtheef.Notifications.Templates.InterviewApprovalDecision.InterviewApprovalDecisionModel>
@{
    // Plain text (in-app bell, SMS): no HTML encoding, otherwise Arabic values come out as &#x...; entities.
    DisableEncoding = true;
    var m = Model.Model;
    var kind = m.Kind switch
    {
        InterviewEntityKind.Template => "نموذج التقييم",
        InterviewEntityKind.Committee => "لجنة المقابلة",
        InterviewEntityKind.Schedule => "جدول المقابلات",
        InterviewEntityKind.ResultReport => "تقرير نتائج المقابلة",
        _ => ""
    };
    var verb = m.Decision switch
    {
        InterviewDecision.Approved => "تم اعتماد",
        InterviewDecision.Returned => "تمت إعادة",
        InterviewDecision.Cancelled => "تم إلغاء",
        _ => ""
    };
    var suffix = m.Decision == InterviewDecision.Returned ? " للتعديل" : "";
}
@verb @kind «@m.EntityName»@(string.IsNullOrWhiteSpace(m.JobTitle) ? "" : $" للوظيفة «{m.JobTitle}»")@suffix.
@if (!string.IsNullOrWhiteSpace(m.Reason))
{
<text>@(m.Decision == InterviewDecision.Approved ? "ملاحظات" : "السبب"): @m.Reason
</text>
}
@if (!string.IsNullOrWhiteSpace(m.DecidedBy))
{
<text>بواسطة: @m.DecidedBy
</text>
}
رابط النظام: @(Model.Branding.OperationsUrl + InterviewNotificationLinks.Resolve(m.Kind, m.LinkPath))
