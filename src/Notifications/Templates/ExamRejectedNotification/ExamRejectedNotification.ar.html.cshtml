@model Tawtheef.Notifications.Context.TemplateContext<Tawtheef.Notifications.Templates.ExamRejectedNotification.ExamRejectedNotificationModel>

@{
    var branding = Model.Branding;
    var exam = Model.Model;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>@branding.ProductNameAr - رفض الاختبار</title></head>
<body style="margin:0;padding:0;background:#f6f7fb;color:#111827;font-family:Arial,sans-serif;">
  <div style="max-width:600px;margin:24px auto;background:#fff;border:1px solid #e5e7eb;border-radius:14px;overflow:hidden;">
    <div style="height:8px;background:@branding.PrimaryHex;"></div>
    <div style="padding:28px;"><h1 style="margin:0 0 12px;font-size:22px;">تم رفض الاختبار</h1><p>تم رفض الاختبار <strong>@exam.ExamNumber</strong>.</p><p style="padding:12px;background:#fef2f2;border-radius:8px;"><strong>سبب الرفض:</strong><br>@exam.Note</p></div>
    <div style="padding:0 28px 24px;color:#6b7280;font-size:12px;">مع التحية،<br>فريق @branding.ProductNameAr</div>
  </div>
</body>
</html>
