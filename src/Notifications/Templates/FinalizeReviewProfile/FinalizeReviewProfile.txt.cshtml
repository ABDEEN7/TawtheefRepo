@using Tawtheef.Domain.Entities.Users
@model Tawtheef.Notifications.Context.TemplateContext<Tawtheef.Notifications.Templates.FinalizeReviewProfile.FinalizeReviewProfileModel>

@{
    var b = Model.Branding;
    var m = Model.Model;

    var isAccepted = m.Status == UserProfileStatus.Approved;
    var profileUrl = b.RecruitmentUrl;
}

@if (isAccepted)
{
@:Profile Approved
@:
@:Dear Candidate,
@:Your profile has been approved on the Careers platform.
@:
@:Portal Link: @profileUrl
}
else
{
@:Profile Returned for Update
@:
@:Dear Candidate,
@:Your profile has been returned for update. Please log in to the platform to review your information and complete the required changes.
@:
@:Portal Link: @profileUrl
}