@using Tawtheef.Domain.Entities.Users
@model Tawtheef.Notifications.Context.TemplateContext<Tawtheef.Notifications.Templates.FinalizeReviewProfile.FinalizeReviewProfileModel>

@{
    var b = Model.Branding;
    var m = Model.Model;

    var primary = b.PrimaryHex;
    var product = b.ProductName;
    var website = b.WebsiteUrl;
    var logo = b.LogoUrl;

    var isAccepted = m.Status == UserProfileStatus.Approved;

    // Optional: a single note string or list of reasons
    string? notes = null; 
    IEnumerable<string>? reasons = null; 

    var profileUrl = website;

    var title = isAccepted ? "تمت الموافقة على ملفك الشخصي" : "ملفك الشخصي بحاجة لتحديثات";
    var badgeText = isAccepted ? "تمت الموافقة" : "مطلوب إجراء";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@product - نتيجة مراجعة الملف الشخصي</title>
  <style>
    body { margin:0; padding:0; background:#f6f7fb; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color:#111827; text-align: right; }
    .container { max-width:600px; margin:24px auto; background:#ffffff; border:1px solid #e5e7eb; border-radius:14px; overflow:hidden; box-shadow:0 8px 20px rgba(0,0,0,0.06); }
    .brand-bar { height:8px; background:@primary; }
    .content { padding:28px; }
    .title { font-size:22px; font-weight:700; margin:0 0 12px; }
    .text { font-size:15px; line-height:22px; margin:0 0 16px; }
    .badge { display:inline-block; font-size:13px; font-weight:700; color:@primary; background:#f7f1f5; padding:6px 10px; border-radius:999px; }
    .cta { display:inline-block; padding:12px 18px; background:@primary; color:#ffffff; text-decoration:none; border-radius:8px; font-weight:700; font-size:14px; }
    .muted { font-size:12px; color:#6b7280; margin:0; }
    .footer { padding:0 28px 24px; text-align: right; }
    .logo { max-width:140px; height:auto; }
    .divider { height:1px; background:#e5e7eb; margin:20px 0; }
    .notes-box { background:#fbf6f8; border:1px solid #efe7eb; padding:14px 16px; border-radius:10px; margin-bottom: 16px; }
    .notes-title { font-size:14px; font-weight:800; color:#111827; margin:0 0 8px 0; }
    .notes-item { font-size:14px; line-height:20px; color:#111827; margin:0 0 6px 0; }
  </style>
</head>
<body>
  <div class="container" style="direction: rtl;">
    <div class="brand-bar"></div>
    <div class="content">
      @if (!string.IsNullOrWhiteSpace(logo))
      {
        <a href="@website" target="_blank">
          <img class="logo" src="@logo" alt="@product" style="display: block; margin: 0 auto;">
        </a>
        <br/>
      }
      <p class="badge">@badgeText</p>
      <h1 class="title">@title</h1>
      <p class="text">مرحباً،</p>
      
      @if (isAccepted)
      {
        <p class="text">
          يسعدنا إبلاغكم بأنه قد تم <strong>قبول ملفكم الشخصي</strong> في منصة @product.
        </p>
        <p class="text">
          يمكنكم الآن متابعة استخدام المنصة بشكل طبيعي والوصول لكافة الميزات.
        </p>
      }
      else
      {
        <p class="text">
          لقد تمت <strong>إعادة ملفكم الشخصي لإجراء تحديثات</strong>. يرجى مراجعة الملاحظات أدناه، وإجراء التعديلات المطلوبة، ثم إعادة إرسال الملف.
        </p>
        
        @if (!string.IsNullOrWhiteSpace(notes) || (reasons != null && reasons.Any()))
        {
          <div class="notes-box">
            <div class="notes-title">ملاحظات المراجعة</div>
            @if (!string.IsNullOrWhiteSpace(notes))
            {
              <p class="notes-item">@notes</p>
            }
            @if (reasons != null && reasons.Any())
            {
              <ul style="padding-right:18px; margin:10px 0 0 0;">
                @foreach (var r in reasons)
                {
                  if (!string.IsNullOrWhiteSpace(r))
                  {
                    <li class="notes-item">@r</li>
                  }
                }
              </ul>
            }
          </div>
        }
      }

      <p class="text" style="margin-top: 24px; text-align: center;">
        <a class="cta" style="color: white;" href="@profileUrl" target="_blank">فتح الملف الشخصي</a>
      </p>
      
      <p class="text">
        إذا كنت بحاجة للمساعدة، يرجى التواصل مع فريق الدعم الفني وسنكون سعداء بمساعدتك.
      </p>

      <div class="divider"></div>
      <p class="muted">
        إذا كان الزر لا يعمل، يرجى نسخ هذا الرابط ولصقه في متصفحك: @profileUrl
      </p>
    </div>
    <div class="footer">
      <p class="muted">مع أطيب التحيات،<br>فريق عمل @product</p>
      <p class="muted">© @(DateTime.UtcNow.Year) @product. جميع الحقوق محفوظة.</p>
    </div>
  </div>
</body>
</html>