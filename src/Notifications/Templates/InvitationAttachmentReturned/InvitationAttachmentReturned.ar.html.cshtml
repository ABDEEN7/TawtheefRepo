@model Tawtheef.Notifications.Context.TemplateContext<Tawtheef.Notifications.Templates.InvitationAttachmentReturned.InvitationAttachmentReturnedModel>

@{
    var b = Model.Branding;
    var m = Model.Model;

    var primary = b.PrimaryHex;
    var product = b.ProductName;
    var support = b.SupportEmail;
    var website = b.WebsiteUrl;
    var logo = b.LogoUrl;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@product - إعادة المرفق</title>
  <style>
    body { margin:0; padding:0; background:#f6f7fb; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color:#111827; }
    .container { max-width:600px; margin:24px auto; background:#ffffff; border:1px solid #e5e7eb; border-radius:14px; overflow:hidden; box-shadow:0 8px 20px rgba(0,0,0,0.06); }
    .brand-bar { height:8px; background:@primary; }
    .content { padding:28px; text-align: right; }
    .title { font-size:22px; font-weight:700; margin:0 0 12px; }
    .text { font-size:15px; line-height:22px; margin:0 0 16px; }
    .badge { display:inline-block; font-size:13px; font-weight:700; color:#d97706; background:#fffbeb; padding:6px 10px; border-radius:999px; }
    .cta { display:inline-block; padding:12px 18px; background:@primary; color:#ffffff; text-decoration:none; border-radius:8px; font-weight:700; font-size:14px; }
    .notice { padding:14px; background:#f9fafb; border-radius:8px; border-right:4px solid #d97706; margin-bottom:16px; }
    .muted { font-size:12px; color:#6b7280; margin:0; }
    .footer { padding:0 28px 24px; text-align: right; }
    .logo { max-width:140px; height:auto; }
    .divider { height:1px; background:#e5e7eb; margin:20px 0; }
  </style>
</head>
<body>
  <div class="container">
    <div class="brand-bar"></div>
    <div class="content">
      @if (!string.IsNullOrWhiteSpace(logo))
      {
        <a href="@website" target="_blank">
          <img class="logo" src="@logo" alt="@product" style="display: block; margin: 0 auto;">
        </a>
        <br/>
      }
      <p class="badge">مطلوب إجراء</p>
      <h1 class="title">مطلوب اهتمام لطلبك الوظيفي</h1>
      <p class="text">عزيزي المرشح،</p>
      <p class="text">
        تمت إعادة أحد المرفقات التي قدمتها لطلبك الوظيفي من أجل التصحيح.
      </p>
      <div class="notice">
        <p class="text" style="margin-bottom:4px; font-weight:bold;">المرفق:</p>
        <p class="text" style="font-size:14px; color:#6b7280;">@m.AttachmentTitle</p>
        <p class="text" style="margin-top:8px; margin-bottom:4px; font-weight:bold;">ملاحظة المراجع من الموارد البشرية:</p>
        <p class="text" style="font-size:14px; color:#6b7280;">@(string.IsNullOrWhiteSpace(m.ReviewNote) ? "يرجى الرجوع إلى منصة التوظيف للحصول على التفاصيل." : m.ReviewNote)</p>
      </div>
      <p class="text">
        يرجى تسجيل الدخول إلى منصة التوظيف لإعادة تحميل المستند المصحح وإعادة تقديم طلبك.
      </p>
      <a class="cta" style="color: white;" href="@website" target="_blank">الدخول إلى منصة التوظيف</a>
      <div class="divider"></div>
      <p class="muted">
         إذا لم يعمل الزر، يرجى نسخ هذا الرابط ولصقه في المتصفح: @website
      </p>
    </div>
    <div class="footer">
      <p class="muted">مع تحيات،<br>فريق عمل @product</p>
      <p class="muted">للدعم الفني: <a href="mailto:@support" style="color:@primary; text-decoration:none;" target="_blank">@support</a></p>
      <p class="muted">© @(DateTime.UtcNow.Year) @product. جميع الحقوق محفوظة.</p>
    </div>
  </div>
</body>
</html>
