@model Tawtheef.Notifications.Context.TemplateContext<Tawtheef.Notifications.Templates.InvitationAttachmentReturned.InvitationAttachmentReturnedModel>

@{
    var b = Model.Branding;
    var m = Model.Model;

    var primary = b.PrimaryHex;
    var product = b.ProductName;
    var support = b.SupportEmail;
    var website = b.RecruitmentUrl;
    var logo = b.LogoUrl;
}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@product - Attachment Returned</title>
  <style>
    body { margin:0; padding:0; background:#f6f7fb; font-family: Arial, sans-serif; color:#111827; }
    .container { max-width:600px; margin:24px auto; background:#ffffff; border:1px solid #e5e7eb; border-radius:14px; overflow:hidden; box-shadow:0 8px 20px rgba(0,0,0,0.06); }
    .brand-bar { height:8px; background:@primary; }
    .content { padding:28px; }
    .title { font-size:22px; font-weight:700; margin:0 0 12px; }
    .text { font-size:15px; line-height:22px; margin:0 0 16px; }
    .badge { display:inline-block; font-size:13px; font-weight:700; color:#d97706; background:#fffbeb; padding:6px 10px; border-radius:999px; }
    .cta { display:inline-block; padding:12px 18px; background:@primary; color:#ffffff; text-decoration:none; border-radius:8px; font-weight:700; font-size:14px; }
    .notice { padding:14px; background:#f9fafb; border-radius:8px; border-left:4px solid #d97706; margin-bottom:16px; }
    .muted { font-size:12px; color:#6b7280; margin:0; }
    .footer { padding:0 28px 24px; }
    .logo { max-width:180px; max-height:60px; width:auto; height:auto; }
    .divider { height:1px; background:#e5e7eb; margin:20px 0; }
  </style>
</head>
<body>
  <div class="container">
    <div class="brand-bar"></div>
    <div class="content">
      @if (!string.IsNullOrWhiteSpace(logo))
      {
        <a href="@website" target="_blank">
          <img class="logo" src="@logo" alt="@product" style="display: block; margin: 0 auto 20px; max-height: 60px; width: auto;">
        </a>
      }
      <p class="badge">Action Required</p>
      <h1 class="title">Attachment Returned for Review</h1>
      <p class="text">Dear Candidate,</p>
      <p class="text">
        We would like to inform you that one of the attachments you submitted with your job application has been returned for correction.
      </p>
      <div class="notice">
        <p class="text" style="margin-bottom:4px; font-weight:bold;">Attachment: @m.AttachmentTitle</p>
        <p class="text" style="margin-top:8px; margin-bottom:4px; font-weight:bold;">Notes:</p>
        <p class="text" style="font-size:14px; color:#6b7280;">@(string.IsNullOrWhiteSpace(m.ReviewNote) ? "Please refer to the platform for details." : m.ReviewNote)</p>
      </div>
      <p class="text">
        Please log in to the platform to review the attachments and notes related to your request and take the necessary action.
      </p>
      <a class="cta" style="color: white;" href="@website" target="_blank">Access the Platform</a>
      <div class="divider"></div>
      <p class="muted">
        Portal Link: @website
      </p>
    </div>
    <div class="footer">
      <p class="muted">Best regards,<br>@product Team</p>
      <p class="muted">© @(DateTime.UtcNow.Year) @product. All rights reserved.</p>
    </div>
  </div>
</body>
</html>
