@model Tawtheef.Notifications.Context.TemplateContext<Tawtheef.Notifications.Templates.TestSessionStaffAssignedNotification.TestSessionStaffAssignedNotificationModel>

@{
    var branding = Model.Branding;
    var testSession = Model.Model;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>@branding.ProductNameEn - Test Session Scheduled</title>

    <style>
        body {
            margin: 0;
            padding: 0;
            background: #f6f7fb;
            color: #111827;
            font-family: Arial, sans-serif;
        }

        .container {
            max-width: 600px;
            margin: 24px auto;
            overflow: hidden;
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 14px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, .06);
        }

        .brand-bar {
            height: 8px;
            background: @branding.PrimaryHex;
        }

        .content {
            padding: 28px;
        }

        .title {
            margin: 0 0 12px;
            font-size: 22px;
        }

        .text {
            margin: 0 0 16px;
            font-size: 15px;
            line-height: 22px;
        }

        .footer {
            padding: 0 28px 24px;
            color: #6b7280;
            font-size: 12px;
        }
    </style>
</head>
<body>
<div class="container">
    <div class="brand-bar"></div>

    <div class="content">
        <h1 class="title">Test Session Scheduled</h1>

        <p class="text">Dear Employee,</p>

        <p class="text">
            A test session has been scheduled for <strong>@testSession.ExamName</strong> - <strong>@testSession.JobTitle</strong><br>
            on <strong>@testSession.TestDate.ToString("yyyy/MM/dd", System.Globalization.CultureInfo.InvariantCulture)</strong><br>
            from <strong>@testSession.StartTime.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture)</strong> to <strong>@testSession.EndTime.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture)</strong>.
        </p>
    </div>

    <div class="footer">
        Regards,<br>
        @branding.ProductNameEn Team
    </div>
</div>
</body>
</html>
