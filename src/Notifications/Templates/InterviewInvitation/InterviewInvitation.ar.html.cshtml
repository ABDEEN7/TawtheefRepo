@model Tawtheef.Notifications.Context.TemplateContext<Tawtheef.Notifications.Templates.InterviewInvitation.InterviewInvitationModel>

@{
    var b = Model.Branding;
    var m = Model.Model;

    var primary = b.PrimaryHex;
    var product = b.ProductNameAr;
    var website = b.RecruitmentUrl;
    var logo = b.LogoUrl;

    var badge = m.IsReminder ? "تذكير بموعد المقابلة" : "دعوة لمقابلة";
    var title = m.IsReminder ? "تذكير: موعد مقابلتكم القادمة" : "دعوة لحضور مقابلة";
    var text = m.IsReminder
        ? "نذكّركم بموعد مقابلتكم القادمة، وتجدون التفاصيل أدناه."
        : "يسعدنا دعوتكم لحضور مقابلة للوظيفة الموضحة أدناه، وتجدون التفاصيل أدناه.";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@product - @title</title>
  <style>
    body { margin:0; padding:0; background:#f6f7fb; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color:#111827; }
    .container { max-width:600px; margin:24px auto; background:#ffffff; border:1px solid #e5e7eb; border-radius:14px; overflow:hidden; box-shadow:0 8px 20px rgba(0,0,0,0.06); }
    .brand-bar { height:8px; background:@primary; }
    .content { padding:28px; text-align: right; }
    .title { font-size:22px; font-weight:700; margin:0 0 12px; }
    .text { font-size:15px; line-height:22px; margin:0 0 16px; }
    .badge { display:inline-block; font-size:13px; font-weight:700; color:@primary; background:#f7f1f5; padding:6px 10px; border-radius:999px; }
    .details { width:100%; border-collapse:collapse; margin:0 0 20px; font-size:14px; }
    .details td { padding:8px 0; border-bottom:1px solid #f1f2f6; vertical-align:top; }
    .details td.label { color:#6b7280; width:35%; }
    .details a { color:@primary; }
    .cta { display:inline-block; padding:12px 18px; background:@primary; color:#ffffff; text-decoration:none; border-radius:8px; font-weight:700; font-size:14px; }
    .muted { font-size:12px; color:#6b7280; margin:0; }
    .footer { padding:0 28px 24px; text-align: right; }
    .logo { max-width:140px; height:auto; }
    .divider { height:1px; background:#e5e7eb; margin:20px 0; }
  </style>
</head>
<body>
  <div class="container" style="direction: rtl;">
    <div class="brand-bar"></div>
    <div class="content">
      @if (!string.IsNullOrWhiteSpace(logo))
      {
        <a href="@website" target="_blank">
          <img class="logo" src="@logo" alt="@product" style="display: block; margin: 0 auto;">
        </a>
        <br/>
      }
      <p class="badge">@badge</p>
      <h1 class="title">@title</h1>
      <p class="text">@(string.IsNullOrWhiteSpace(m.CandidateName) ? "عزيزي المرشح،" : $"السيد/ة {m.CandidateName}،")</p>
      <p class="text">تحية طيبة،</p>
      <p class="text">@text</p>
      <table class="details" role="presentation">
        <tr><td class="label">الوظيفة</td><td>@m.JobTitle</td></tr>
        <tr><td class="label">التاريخ</td><td>@m.InterviewDay <span dir="ltr">@m.InterviewDate</span></td></tr>
        <tr><td class="label">الوقت (بتوقيت قطر)</td><td>من @m.StartTime إلى @m.EndTime</td></tr>
        @if (m.IsRemote)
        {
          <tr><td class="label">نوع المقابلة</td><td>عن بُعد</td></tr>
          @if (!string.IsNullOrWhiteSpace(m.MeetingUrl))
          {
            <tr><td class="label">رابط الاجتماع</td><td><a href="@m.MeetingUrl" target="_blank" dir="ltr">@m.MeetingUrl</a></td></tr>
          }
        }
        else
        {
          <tr><td class="label">نوع المقابلة</td><td>حضوري</td></tr>
          @if (!string.IsNullOrWhiteSpace(m.Location))
          {
            <tr><td class="label">المكان</td><td>@m.Location</td></tr>
          }
          @if (!string.IsNullOrWhiteSpace(m.LocationMapUrl))
          {
            <tr><td class="label">الخريطة</td><td><a href="@m.LocationMapUrl" target="_blank">عرض الموقع</a></td></tr>
          }
        }
        @if (!string.IsNullOrWhiteSpace(m.Instructions))
        {
          <tr><td class="label">التعليمات</td><td>@m.Instructions</td></tr>
        }
      </table>
      <p class="text">@(m.IsRemote ? "يرجى الانضمام قبل موعد المقابلة ببضع دقائق." : "يرجى الحضور قبل موعد المقابلة ببضع دقائق وإحضار الهوية الشخصية.")</p>
      <a class="cta" style="color: white;" href="@website" target="_blank">الدخول إلى @product</a>
      <div class="divider"></div>
      <p class="muted">
        رابط النظام: @website
      </p>
    </div>
    <div class="footer">
      <p class="muted">مع خالص التحية،<br>فريق عمل @product</p>
      <p class="muted">© @(DateTime.UtcNow.Year) @product. جميع الحقوق محفوظة.</p>
    </div>
  </div>
</body>
</html>
