@model Tawtheef.Notifications.Context.TemplateContext<Tawtheef.Notifications.Templates.InterviewInvitation.InterviewInvitationModel>
@{
    // Plain text (in-app bell, SMS): no HTML encoding, otherwise Arabic values come out as &#x...; entities.
    DisableEncoding = true;
    var m = Model.Model;
    var opening = m.IsReminder
        ? $"تذكير: موعد مقابلتكم لوظيفة «{m.JobTitle}» يوم {m.InterviewDay} {m.InterviewDate}، من {m.StartTime} إلى {m.EndTime} (بتوقيت قطر)."
        : $"يسعدنا دعوتكم لحضور مقابلة لوظيفة «{m.JobTitle}» يوم {m.InterviewDay} {m.InterviewDate}، من {m.StartTime} إلى {m.EndTime} (بتوقيت قطر).";
}
@opening
@if (m.IsRemote)
{
<text>مقابلة عن بُعد@(string.IsNullOrWhiteSpace(m.MeetingUrl) ? "" : ": " + m.MeetingUrl)
</text>
}
else if (!string.IsNullOrWhiteSpace(m.Location))
{
<text>المكان: @m.Location@(string.IsNullOrWhiteSpace(m.LocationMapUrl) ? "" : " - " + m.LocationMapUrl)
</text>
}
@if (!string.IsNullOrWhiteSpace(m.Instructions))
{
<text>التعليمات: @m.Instructions
</text>
}
رابط النظام: @Model.Branding.RecruitmentUrl
