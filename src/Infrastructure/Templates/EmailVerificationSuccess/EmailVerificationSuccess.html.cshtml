@model Infrastructure.Services.NotificationServices.TemplateContext<Infrastructure.Templates.EmailVerificationSuccess.EmailVerificationSuccessModel>
@{
    var b = Model.Branding; // PrimaryHex, ProductName, SupportEmail, (optional) LogoUrl
    var m = Model.Model;    // UserName, (optional) DashboardLink
    var primary = b.PrimaryHex;
    var product = b.ProductName;
    var support = b.SupportEmail;
    var logo    = b.LogoUrl;
    var user    = m.UserName;
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="x-apple-disable-message-reformatting" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Email Verified</title>
  <!--[if mso]>
  <noscript>
    <xml>
      <o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings>
    </xml>
  </noscript>
  <![endif]-->
</head>
<body style="margin:0; padding:20px; background:#f6f6f6; font-family:Arial, sans-serif;">

  <!-- outer table wrapper -->
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:collapse;">
    <tr>
      <td align="center" style="padding:0;">

        <!-- container -->
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="max-width:600px; background:#ffffff; border-radius:12px; overflow:hidden;">
          <!-- header / brand -->
          <tr>
            <td align="left" style="padding:20px 24px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="left" style="vertical-align:middle;">
                    @if (!string.IsNullOrWhiteSpace(logo)){
                      <img src="@logo" width="120" alt="@product" style="display:block; border:0; outline:none; text-decoration:none; max-width:120px; height:auto;" />
                    } else {
                      <div style="font-weight:bold; font-size:18px; color:@primary;">@product</div>
                    }
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- hero / check icon + title -->
          <tr>
            <td align="left" style="padding:0 24px 8px 24px;">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td width="44" height="44" align="center" valign="middle"
                      style="background:@primary; color:#ffffff; border-radius:999px; font-size:24px; line-height:44px; font-weight:bold;">
                    ✓
                  </td>
                  <td width="12"></td>
                  <td align="left">
                    <div style="font-size:22px; line-height:28px; color:@primary; font-weight:bold;">
                      Welcome aboard, @user!
                    </div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- body copy -->
          <tr>
            <td align="left" style="padding:8px 24px 4px 24px;">
              <div style="font-size:16px; line-height:24px; color:#111827;">
                Your email has been successfully verified. You’re all set to start exploring our platform.
              </div>
            </td>
          </tr>

          <!-- “what’s next” panel -->
          <tr>
            <td align="left" style="padding:12px 24px 8px 24px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                     style="background:#f2f5ff; border-left:4px solid @primary; border-radius:8px;">
                <tr>
                  <td style="padding:12px 14px;">
                    <div style="font-size:15px; line-height:22px; color:#111827;">
                      <strong>What’s next?</strong>
                    </div>
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top:6px;">
                      <tr>
                        <td valign="top" style="font-size:16px; line-height:22px; color:#111827; padding-right:8px;">•</td>
                        <td style="font-size:15px; line-height:22px; color:#111827;">Complete your profile</td>
                      </tr>
                      <tr>
                        <td valign="top" style="font-size:16px; line-height:22px; color:#111827; padding-right:8px;">•</td>
                        <td style="font-size:15px; line-height:22px; color:#111827;">Browse courses</td>
                      </tr>
                      <tr>
                        <td valign="top" style="font-size:16px; line-height:22px; color:#111827; padding-right:8px;">•</td>
                        <td style="font-size:15px; line-height:22px; color:#111827;">Start learning</td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- footer -->
          <tr>
            <td align="left" style="padding:20px 24px 24px 24px;">
              <div style="font-size:12px; line-height:18px; color:#6B7280;">
                Sent by @product · Support: <a href="mailto:@support" style="color:@primary; text-decoration:none;">@support</a><br />
                © @(DateTime.UtcNow.Year) @product. All rights reserved.
              </div>
            </td>
          </tr>
        </table>
        <!-- /container -->

      </td>
    </tr>
  </table>
  <!-- /outer wrapper -->

</body>
</html>
