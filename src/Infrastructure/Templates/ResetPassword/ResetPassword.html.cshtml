@model Infrastructure.Services.NotificationServices.TemplateContext<Infrastructure.Templates.ResetPassword.ResetPasswordModel>
@{
    var b = Model.Branding; // PrimaryHex, ProductName, SupportEmail, (optional) LogoUrl
    var m = Model.Model;    // Link, (optional) RecipientName, ExpiryMinutes
    var primary = b.PrimaryHex;
    var product = b.ProductName;
    var support = b.SupportEmail;
    var logo    = b.LogoUrl;

    var link    = m.Link;
    var hasLink = !string.IsNullOrWhiteSpace(link);
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="x-apple-disable-message-reformatting" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Password Reset</title>
</head>
<body style="margin:0; padding:20px; background:#f6f6f6; font-family:Arial, sans-serif;">

  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
    <tr>
      <td align="center">

        <!-- container -->
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"
               style="max-width:600px; background:#ffffff; border-radius:12px; overflow:hidden;">

          <!-- header / brand -->
          <tr>
            <td align="left" style="padding:20px 24px;">
              @if (!string.IsNullOrWhiteSpace(logo)){
                <img src="@logo" width="120" alt="@product"
                     style="display:block; max-width:120px; height:auto; border:0; outline:none; text-decoration:none;" />
              } else {
                <div style="font-weight:bold; font-size:18px; color:@primary;">@product</div>
              }
            </td>
          </tr>

          <!-- title -->
          <tr>
            <td align="left" style="padding:0 24px 8px 24px;">
              <div style="font-size:22px; line-height:28px; font-weight:bold; color:@primary;">
                Reset your password
              </div>
            </td>
          </tr>

          <!-- intro -->
          <tr>
            <td align="left" style="padding:0 24px 12px 24px;">
              <div style="font-size:16px; line-height:24px; color:#111827;">
                @* @(string.IsNullOrWhiteSpace(user) ? "" : $"Hi {user},<br/>") *@
                We received a request to reset your password.
                @* @(expiry.HasValue ? $" This link will expire in {expiry.Value} minutes." : "") *@
              </div>
            </td>
          </tr>

          <!-- CTA -->
          @if (hasLink)
          {
            <tr>
              <td align="left" style="padding:0 24px 6px 24px;">
                <!--[if mso]>
                <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" href="@link"
                  style="height:44px;v-text-anchor:middle;width:210px;" arcsize="10%" stroke="f" fillcolor="@primary">
                  <w:anchorlock/>
                  <center style="color:#ffffff;font-family:Arial,sans-serif;font-size:16px;">Reset Password</center>
                </v:roundrect>
                <![endif]-->
                <!--[if !mso]><! -->
                <a href="@link" target="_blank"
                   style="display:inline-block; background:@primary; color:#ffffff; padding:12px 24px;
                          border-radius:6px; font-size:16px; line-height:20px;">
                  Reset Password
                </a>
                <!--<![endif]-->
              </td>
            </tr>

            <!-- plain link fallback -->
            <tr>
              <td align="left" style="padding:6px 24px 12px 24px;">
                <div style="font-size:12px; line-height:18px; color:#6B7280;">
                  If the button doesn’t work, copy this link into your browser:<br/>
                  <span style="word-break:break-all;">@link</span>
                </div>
              </td>
            </tr>
          }

          <!-- security notice -->
          <tr>
            <td align="left" style="padding:0 24px 16px 24px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                     style="background:#fff8e6; border:1px solid #ffe8a3; border-radius:8px;">
                <tr>
                  <td style="padding:12px 14px;">
                    <div style="font-size:15px; line-height:22px; color:#111827;">
                      <strong>Security notice:</strong>
                      If you didn’t request this, you can safely ignore this email. Your password will remain unchanged.
                    </div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- footer -->
          <tr>
            <td align="left" style="padding:20px 24px 24px 24px;">
              <div style="font-size:12px; line-height:18px; color:#6B7280;">
                Sent by @product · Support:
                <a href="mailto:@support" style="color:@primary; text-decoration:none;">@support</a><br/>
                © @(DateTime.UtcNow.Year) @product. All rights reserved.
              </div>
            </td>
          </tr>

        </table>
        <!-- /container -->

      </td>
    </tr>
  </table>

</body>
</html>
