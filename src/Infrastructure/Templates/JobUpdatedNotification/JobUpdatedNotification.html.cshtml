@model Tawtheef.Infrastructure.Services.NotificationServices.TemplateContext<Application.Operation.Templates.JobUpdatedNotification.JobUpdatedNotificationModel>

@{
    var b = Model.Branding;
    var m = Model.Model;

    var primary = b.PrimaryHex;
    var product = b.ProductName;
    var support = b.SupportEmail;
    var website = b.WebsiteUrl;
    var logo = b.LogoUrl;

    var jobTitle = string.IsNullOrWhiteSpace(m.JobTitle) ? "the job" : m.JobTitle;
}

<!DOCTYPE  html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@product - Job Updated</title>
  <style>
    body { margin:0; padding:0; background:#f7f4f6; font-family: Arial, sans-serif; }
    .container { max-width:600px; margin:20px auto; background:#ffffff; border:1px solid #efe7eb; border-radius:12px; overflow:hidden; }
    .brand-bar { height:6px; background:@primary; }
    .content { padding:24px; color:#111827; }
    .title { font-size:20px; font-weight:700; margin:0 0 12px 0; }
    .text { font-size:15px; line-height:22px; margin:0 0 16px 0; }
    .footer { font-size:12px; color:#6B7280; padding:16px 24px 24px; }
    .logo { max-width:140px; height:auto; }
  </style>
</head>
<body>
  <div class="container">
    <div class="brand-bar"></div>
    <div class="content">
      @if (!string.IsNullOrWhiteSpace(logo))
      {
        <a href="@website">
          <img class="logo" src="@logo" alt="@product">
        </a>
      }
      <h1 class="title">Job updated</h1>
      <p class="text">
        The job (@jobTitle) has been updated.
      </p>
      <p class="text">
        Please log in to the Tawtheef system to review the updated details.
      </p>
    </div>
    <div class="footer">
      -- @product<br>
      Support: @support
    </div>
  </div>
</body>
</html>
