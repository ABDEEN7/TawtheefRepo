@model Infrastructure.Services.NotificationServices.TemplateContext<Infrastructure.Templates.EmailConfirmation.EmailConfirmationModel>
@{
    var b = Model.Branding;
    var m = Model.Model;
    var primary = b.PrimaryHex;
    var product = b.ProductName;
    var support = b.SupportEmail;
    var link    = m.Link;
    var logo    = b.LogoUrl;
    var hasLink = !string.IsNullOrWhiteSpace(link);
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="x-apple-disable-message-reformatting">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Email Confirmation</title>
  <!--[if mso]>
  <noscript>
    <xml>
      <o:OfficeDocumentSettings>
        <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
    </xml>
  </noscript>
  <![endif]-->
  <style>
    /* Base resets */
    html, body { margin:0 !important; padding:0 !important; height:100% !important; width:100% !important; }
    * { -ms-text-size-adjust:100%; -webkit-text-size-adjust:100%; }
    table, td { mso-table-lspace:0pt !important; mso-table-rspace:0pt !important; }
    table { border-collapse:collapse !important; }
    img { -ms-interpolation-mode:bicubic; border:0; outline:none; text-decoration:none; display:block; }
    a { text-decoration:none; }

    /* Container */
    .email-wrap { width:100%; background:#f6f6f6; }
    .container { width:100%; max-width:600px; margin:0 auto; background:#ffffff; border-radius:12px; overflow:hidden; }
    .px { padding-left:24px; padding-right:24px; }
    .py { padding-top:24px; padding-bottom:24px; }

    /* Typography */
    .h2 { font-family:Arial, sans-serif; font-size:22px; line-height:28px; color:@primary; margin:0 0 8px 0; }
    .text { font-family:Arial, sans-serif; font-size:16px; line-height:24px; color:#111827; margin:0 0 16px 0; }
    .muted { font-family:Arial, sans-serif; font-size:12px; line-height:18px; color:#6B7280; }

    /* Button (fallback) */
    .btn { display:inline-block; padding:12px 24px; background:@primary; color:#ffffff !important; border-radius:6px; font-family:Arial, sans-serif; font-size:16px; line-height:20px; }

    /* Preheader (hidden preview text) */
    .preheader { display:none; visibility:hidden; opacity:0; color:transparent; height:0; width:0; max-height:0; max-width:0; overflow:hidden; mso-hide:all; }

    /* Mobile */
    @@media (max-width: 600px) {
      .px { padding-left:16px !important; padding-right:16px !important; }
      .py { padding-top:20px !important; padding-bottom:20px !important; }
      .h2 { font-size:20px !important; line-height:26px !important; }
      .text { font-size:15px !important; line-height:22px !important; }
    }

    /* Dark mode */
    @@media (prefers-color-scheme: dark) {
      .email-wrap { background:#0b0b0b !important; }
      .container { background:#111214 !important; }
      .h2 { color:@primary !important; }
      .text { color:#e5e7eb !important; }
      .muted { color:#9ca3af !important; }
    }
  </style>
</head>
<body class="email-wrap" style="background:#f6f6f6; margin:0; padding:20px;">
  <!-- Preheader text (shows in inbox preview) -->
  <div class="preheader">
    Confirm your email to finish setting up @product.
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f6f6f6;">
    <tr>
      <td align="center" style="padding:20px;">
        <table role="presentation" class="container" cellpadding="0" cellspacing="0">
          <!-- Header / Logo -->
          <tr>
            <td class="px py" align="left" style="padding-top:20px; padding-bottom:8px;">
              <table role="presentation" width="100%">
                <tr>
                  <td align="left" style="vertical-align:middle;">
                    @if (!string.IsNullOrWhiteSpace(logo))
                    {
                      <img src="@logo" alt="@product" width="120" height="auto" style="max-width:120px;">
                    }
                    else
                    {
                      <div style="font-family:Arial, sans-serif; font-weight:bold; font-size:18px; color:@primary;">@product</div>
                    }
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Hero -->
          <tr>
            <td class="px" style="padding-top:8px;">
              <h2 class="h2" style="color:@primary;">Confirm your email</h2>
              <p class="text">
                @(string.IsNullOrWhiteSpace((string)m.RecipientName) ? "Thank you for signing up!" : $"Hi {(string)m.RecipientName}, thanks for signing up!")
                Please confirm your email using the button below.
              </p>
            </td>
          </tr>

          <!-- CTA Button -->
          @if (hasLink)
          {
          <tr>
            <td class="px" style="padding-top:8px; padding-bottom:8px;">
              <!--[if mso]>
              <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="@link" style="height:44px;v-text-anchor:middle;width:220px;" arcsize="10%" stroke="f" fillcolor="@primary">
                <w:anchorlock/>
                <center style="color:#ffffff;font-family:Arial,sans-serif;font-size:16px;">Confirm Email</center>
              </v:roundrect>
              <![endif]-->
              <!--[if !mso]>< -->
              <a class="btn" href="@link" target="_blank" style="display:inline-block; background:@primary; color:#ffffff; padding:12px 24px; border-radius:6px; font-family:Arial,sans-serif; font-size:16px;">
                Confirm Email
              </a>
              <!--<![endif]-->
            </td>
          </tr>
          }

          <!-- Raw Link Fallback -->
          @if (hasLink)
          {
          <tr>
            <td class="px" style="padding-top:8px;">
              <p class="muted" style="margin:0;">
                If the button doesn’t work, copy this link into your browser:
              </p>
              <p class="muted" style="margin:6px 0 0 0; word-break:break-all;">
                @link
              </p>
            </td>
          </tr>
          }

          <!-- Help / Support -->
          <tr>
            <td class="px py" style="padding-top:24px;">
              <table role="presentation" width="100%">
                <tr>
                  <td class="muted" style="font-size:12px; color:#6B7280;">
                    Need help? Contact us at <a href="mailto:@support" style="color:@primary;">@support</a>.
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td class="px" style="padding-bottom:24px;">
              <p class="muted" style="margin:0;">
                Sent by @product
              </p>
              <p class="muted" style="margin:4px 0 0 0;">
                © @(DateTime.UtcNow.Year) @product. All rights reserved.
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
