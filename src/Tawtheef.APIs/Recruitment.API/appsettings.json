{
  "App": {
    "Module": "Recruitment"
  },
  "FeatureFlags": { },
  "KeyVault": {
    "Enabled": false
  },
  "AppConfig": {
    "AdminEmail": "info@edu.gov.qa",
    "AdminEmails": [
      "info@edu.gov.qa"
    ],
    "DefaultSignedUrlMinutes": 1440
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "RequestBody": {
      "Enabled": false,
      "Mode": "DevelopmentOnly",
      "MaxLoggedBytes": 4096,
      "BufferThreshold": 65536,
      "BufferLimit": 4194304,
      "AllowPaths": [ "/api/debug" ],
      "DenyPaths": [ "/auth", "/login", "/register", "/otp", "/token", "/password", "/refresh" ],
      "SensitiveKeys": [
        "password", "pass", "pwd",
        "otp", "mfa", "code",
        "token", "access_token", "refresh_token",
        "secret", "apiKey", "apikey",
        "authorization", "bearer",
        "nationalid", "ssn",
        "email", "phone"
      ]
    }
  },
  "AzureMonitor": {
    "Enabled": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "Tawtheef.Recruitment"
    }
  },
  "HodhodSms": {
    "BaseUrl": "http://10.17.1.50/smsservice/smsservice.asmx/",
    "ApplicationId": "Hodhod",
    "DefaultOtpMinutes": 5,
    "ConfirmDelivery": true,
    "Priority": 0
  },
  "EmailSettings": {
    "EmailUser": "tawtheef@edu.gov.qa",
    "SmtpHost": "smtp.edu.gov.qa",
    "SmtpPort": 25,
    "EnableSsl": true,
    "ContactUsEmail": "tawtheef-support@edu.gov.qa",
    "ManagerEmails": "tawtheef-support@edu.gov.qa",
    "LogoPath": "",
    "LogoUrl": "assets/img/logo-black.png"
  },
  "EmailDispatcher": {
    "Workers": 4,
    "MaxAttemptsPerEnvelope": 2,
    "BackoffMs": 400,
    "MaxConsecutiveFailuresBeforeBackoff": 5,
    "DrainOnStop": true,
    "MaxDrainDuration": "00:00:20"
  },  
  "Moi": {
    "BaseUrl": "https://moiapi.edu.gov.qa"
  },
  "Authentication": {
    "Jwt": {
      "ExpiryMinutes": 15,
      "RefreshTokenExpirationDays": 7,
      "TokenType": "Bearer",
      "TokenValidationParameters": {
        "ValidateIssuer": true,
        "ValidateAudience": true,
        "ValidateLifetime": true,
        "ValidateIssuerSigningKey": true,
        "RequireExpirationTime": true,
        "ClockSkew": "00:01:00"
      }
    },
    "Google": {
      "IsEnabled": true,
      "Issuer": "https://accounts.google.com",
      "ClientId": "955628388220-4lp24nkejfjin4sm4p2bsqg6m1c06605.apps.googleusercontent.com",
      "DiscoveryUrl": "https://accounts.google.com/.well-known/openid-configuration"
    },
    "Azure": {
      "IsEnabled": false
    },
    "QatarPass": {
      "BaseUrl": "https://moeheqpservice-stage.edu.gov.qa",
      "TimeoutSeconds": 10
    },
    "QatarResidentOtp": {
      "BaseUrl": "https://moeheapi-svc.edu.gov.qa",
      "AuthenticationPath": "gdxapi/token",
      "VerificationPath": "gdxapi/customerValidation",
      "TimeoutSeconds": 30
    }
  }
}
