{
  "FeatureManagement": {
  },
  "AppConfig": {
    "FrontendUrl": "https://app.tawtheef-demo.com",
    "BackendUrl": "https://api.tawtheef-demo.com",
    "BlobSignKey": "demo-tawtheef-blob-sign-key-1234567890abcdef",
    "AdminEmail": "admin@tawtheef-demo.com",
    "AdminEmails": [
      "admin@tawtheef-demo.com"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=DCSCSQL2DNET01;Database=TawtheefDB;Trust Server Certificate=true;User id=tawtheef_user; Password=Demo@2025;"
  },
  "EmailSettings": {
    "EmailUser": "noreply@tawtheef-demo.com",
    "EmailPass": "demo email pass 1234",
    "SmtpHost": "smtp.tawtheef-demo.com",
    "SmtpPort": 587,
    "EnableSsl": true,
    "ContactUsEmail": "support@tawtheef-demo.com",
    "ManagerEmails": "managers@tawtheef-demo.com",
    "LogoPath": ""
  },
  "Jwt": {
    "Key": "demo-tawtheef-ultra-secure-jwt-key-2025-abcdef1234567890!ChangeThis",
    "Issuer": "https://api.tawtheef-demo.com",
    "Audience": "https://app.tawtheef-demo.com",
    "ExpiryMinutes": 15,
    "RefreshTokenExpirationDays": 7,
    "IssuerSigningKey": "demo-tawtheef-ultra-secure-jwt-key-2025-abcdef1234567890!ChangeThis",
    "IssuerSigningKeyBase64": "ZGVtby10YXd0aGVlZi1zZWN1cmUtanQtdXNlLWtleS0yMDI1LWFjZGVmMTIzNDU2Nzg5MA==",
    "TokenType": "Bearer",
    "TokenValidationParameters": {
      "ValidateIssuer": true,
      "ValidateAudience": true,
      "ValidateLifetime": true,
      "ValidateIssuerSigningKey": true,
      "RequireExpirationTime": true,
      "ClockSkew": "00:01:00"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RecaptchaSettings": {
    "SecretKey": "demo-recaptcha-secret-tawtheef-1234",
    "SiteKey": "demo-recaptcha-sitekey-tawtheef-5678",
    "Version": "v3"
  },
  "Seq": {
    "Url": "https://logs.tawtheef-demo.com",
    "ApiKey": "demo-seq-api-key-tawtheef-12345"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "Tawtheef.WebAPI.Demo"
    }
  },
  "Storage": {
    "Provider": "Azure",
    "RootPath": "C:\\Storage\\TawtheefDemo",
    "PublicSubdir": "public",
    "PrivateSubdir": "private",
    "PublicBaseUrl": "https://cdn.tawtheef-demo.com/files",
    "DefaultSignedUrlMinutes": 15
  },
  "EmailDispatcher": {
    "Workers": 4,
    "MaxAttemptsPerEnvelope": 2,
    "BackoffMs": 400,
    "MaxConsecutiveFailuresBeforeBackoff": 5,
    "DrainOnStop": true,
    "MaxDrainDuration": "00:00:20"
  },
  "Authentication": {
    "Google": {
      "ClientId": "<GOOGLE_CLIENT_ID>",
      "ClientSecret": "<GOOGLE_CLIENT_SECRET>"
    },
    "Microsoft": {
      "ClientId": "<MICROSOFT_CLIENT_ID>",
      "ClientSecret": "<MICROSOFT_CLIENT_SECRET>"
    }
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "contoso.onmicrosoft.com",
    "TenantId": "<TENANT_ID>",
    "ClientId": "<CLIENT_ID>",
    "ClientSecret": "<CLIENT_SECRET>",
    "CallbackPath": "/signin-oidc"
  }
}