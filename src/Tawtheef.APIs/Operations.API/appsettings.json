{
  "App": {
    "Module": "Operation"
  },
  "FeatureFlags": {
    "DirectorySync": true
  },
  "KeyVault": {
    "Enabled": false
  },
  "AppConfig": {
    "AdminEmail": "info@edu.gov.qa",
    "AdminEmails": ["info@edu.gov.qa"],
    "DefaultSignedUrlMinutes": 1440,
    "EnableLookupsCaching": true
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "RequestBody": {
      "Enabled": false,
      "Mode": "DevelopmentOnly",
      "MaxLoggedBytes": 4096,
      "BufferThreshold": 65536,
      "BufferLimit": 4194304,
      "AllowPaths": [ "/api/debug" ],
      "DenyPaths": [ "/auth", "/login", "/register", "/otp", "/token", "/password", "/refresh" ],
      "SensitiveKeys": [
        "password", "pass", "pwd",
        "otp", "mfa", "code",
        "token", "access_token", "refresh_token",
        "secret", "apiKey", "apikey",
        "authorization", "bearer",
        "nationalid", "ssn",
        "email", "phone"
      ]
    }
  },
  "AzureMonitor": {
    "Enabled": false
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName",
      "WithEnvironmentName","WithExceptionDetails",
      "WithEnvironmentUserName", "WithThreadId" ],
    "Properties": { "Application": "Tawtheef.Recruitment" },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Seq": {
    "Url": "",
    "ApiKey": ""
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  
  "HodhodSms": {
    "BaseUrl": "http://10.17.1.50/smsservice/smsservice.asmx/",
    "ApplicationId": "Hodhod",
    "DefaultOtpMinutes": 5,
    "ConfirmDelivery": true,
    "Priority": 0
  },
  "EmailSettings": {
    "EmailUser": "careers@edu.gov.qa",
    "SmtpHost": "smtp.edu.gov.qa",
    "SmtpPort": 25,
    "EnableSsl": true,
    "ContactUsEmail": "careers-support@edu.gov.qa",
    "ManagerEmails": "careers-support@edu.gov.qa",
    "LogoPath": "Templates\\Assets\\logo-en.jpg",
    "LogoUrl": "assets/img/logo-black.png"
  },
  "Moi": {
    "BaseUrl": "https://moiapi.edu.gov.qa"
  },
  "GraphEmail": {
    "FromAddress": "careers@edu.gov.qa",
    "SaveToSentItems": true,
    "LogoPath": "Templates\\Assets\\logo-en.jpg",
    "LogoUrl": "assets/img/logo-black.png"
  },
  "EmailDispatcher": {
    "Workers": 4,
    "MaxAttemptsPerEnvelope": 2,
    "BackoffMs": 400,
    "MaxConsecutiveFailuresBeforeBackoff": 5,
    "DrainOnStop": true,
    "MaxDrainDuration": "00:00:20"
  },

  "Storage": {
    "Provider": "",
    "RootPath": "",
    "PublicBaseUrl": "",
    "AzureConnectionString": ""
  },

  "HrService": {
    "BaseUrl": "https://hrservice.edu.gov.qa",
    "TimeoutSeconds": 30
  },
  "MicrosoftGraph": {
    "BaseUrl": "https://graph.microsoft.com/v1.0",
    "Scopes": "user.read"
  },
  "Authentication": {
    "Jwt": {
      "ExpiryMinutes": 15,
      "RefreshTokenExpirationHours": 168,
      "TokenType": "Bearer",
      "TokenValidationParameters": {
        "ValidateIssuer": true,
        "ValidateAudience": true,
        "ValidateLifetime": true,
        "ValidateIssuerSigningKey": true,
        "RequireExpirationTime": true,
        "ClockSkew": "00:01:00"
      }
    },
    "Google": {
      "IsEnabled": true,
      "Issuer": "https://accounts.google.com",
      "ClientId": "955628388220-4lp24nkejfjin4sm4p2bsqg6m1c06605.apps.googleusercontent.com",
      "DiscoveryUrl": "https://accounts.google.com/.well-known/openid-configuration"
    },
    "Azure": {
      "IsEnabled": true,
      "Domain": "QatarEducation.onmicrosoft.com",
      "CallbackPath": "/signin-oidc",
      "Instance": "https://login.microsoftonline.com/"
    }
  }
}
