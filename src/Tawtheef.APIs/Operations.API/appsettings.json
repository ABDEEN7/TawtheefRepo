{
  "App": {
    "Module": "Operation"
  },
  "FeatureFlags": {
    "DirectorySync": true
  },
  "KeyVault": {
    "Enabled": false
  },
  "AppConfig": {
    "AdminEmail": "info@edu.gov.qa",
    "AdminEmails": ["info@edu.gov.qa"],
    "DefaultSignedUrlMinutes": 1440
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "Tawtheef.Operation"
    }
  },
  "Seq": {
    "Url": "https://careers-admin-log.edu.gov.qa",
    "ApiKey": ""
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  
  "HodhodSms": {
    "BaseUrl": "http://10.17.1.50/smsservice/smsservice.asmx/",
    "ApplicationId": "Hodhod",
    "DefaultOtpMinutes": 5,
    "ConfirmDelivery": true,
    "Priority": 0
  },
  "EmailSettings": {
    "EmailUser": "tawtheef@edu.gov.qa",
    "SmtpHost": "smtp.edu.gov.qa",
    "SmtpPort": 25,
    "EnableSsl": true,
    "ContactUsEmail": "tawtheef-support@edu.gov.qa",
    "ManagerEmails": "tawtheef-support@edu.gov.qa",
    "LogoPath": "",
    "LogoUrl": "assets/img/logo-black.png"
  },
  "EmailDispatcher": {
    "Workers": 4,
    "MaxAttemptsPerEnvelope": 2,
    "BackoffMs": 400,
    "MaxConsecutiveFailuresBeforeBackoff": 5,
    "DrainOnStop": true,
    "MaxDrainDuration": "00:00:20"
  },

  "Storage": {
    "Provider": "",
    "RootPath": "",
    "PublicBaseUrl": "",
    "AzureConnectionString": ""
  },

  "HrService": {
    "BaseUrl": "https://hrservice.edu.gov.qa",
    "TimeoutSeconds": 30
  },
  "MicrosoftGraph": {
    "BaseUrl": "https://graph.microsoft.com/v1.0",
    "Scopes": "user.read"
  },
  "Authentication": {
    "Jwt": {
      "ExpiryMinutes": 15,
      "RefreshTokenExpirationDays": 7,
      "TokenType": "Bearer",
      "TokenValidationParameters": {
        "ValidateIssuer": true,
        "ValidateAudience": true,
        "ValidateLifetime": true,
        "ValidateIssuerSigningKey": true,
        "RequireExpirationTime": true,
        "ClockSkew": "00:01:00"
      }
    },
    "Google": {
      "Issuer": "https://accounts.google.com",
      "ClientId": "955628388220-fk3sh9ofe4m0g40qmibsf1r934e6k7ko.apps.googleusercontent.com",
      "DiscoveryUrl": "https://accounts.google.com/.well-known/openid-configuration"
    },
    "Azure": {
      "Domain": "QatarEducation.onmicrosoft.com",
      "TenantId": "2dcae639-d4a4-4454-82c7-592ab66fc7bd",
      "ClientId": "6b888b0f-ebbb-4443-b104-e2ef3ad58b4f",
      "CallbackPath": "/signin-oidc",
      "Instance": "https://login.microsoftonline.com/"
    }
  }
}
